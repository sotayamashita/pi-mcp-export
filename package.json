    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --fix --report-unused-disable-directives"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sinclair/typebox": "0.34.49",
    "commander": "14.0.3",
    "jiti": "2.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.7.1",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "secretlint": "^11.7.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
