{
  "name": "pi-mcp-export",
  "version": "0.1.0",
  "bin": {
    "pi-mcp-export": "./bin/pi-mcp-export.mjs"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "test": "vitest run  --coverage",
    "typecheck": "tsc --noEmit",
